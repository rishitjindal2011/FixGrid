# ── Supabase ────────────────────────────────────────────────────────────────
# Same project as the consumer app.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"

# Service role key. Bypasses RLS — this is the only credential the admin app
# uses, because cms_templates and seo_admins have RLS on with zero policies.
# NEVER prefix this with NEXT_PUBLIC_. If it reaches the browser, every row in
# the database is readable and writable by anyone who opens devtools.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# ── Session ─────────────────────────────────────────────────────────────────
# Signing key for the admin session JWT. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Must be at least 32 bytes of entropy; the app refuses to start otherwise.
ADMIN_JWT_SECRET="generate-me"

# ── Cross-app links ─────────────────────────────────────────────────────────
# Origin of the consumer app. Preview links and HTML export are resolved
# against this value and nothing else — a URL supplied by the browser is never
# fetched (see src/app/api/export-html/route.ts).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Shared secret for the consumer app's /api/preview endpoint. Must match
# PREVIEW_SECRET in the consumer app's .env.local exactly.
PREVIEW_SECRET="generate-me-too"
