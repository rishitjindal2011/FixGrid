# ── Supabase ────────────────────────────────────────────────────────────────
# Same project as the consumer app and the SEO admin. All three read one database.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"

# Service role key. Bypasses RLS — and here that is the entire point rather than
# a convenience: this console exists to read every customer's bookings and every
# shop's payouts, which no per-user policy will ever return.
# NEVER prefix this with NEXT_PUBLIC_. If it reaches the browser, every row in
# the database is readable and writable by anyone who opens devtools.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# ── Session ─────────────────────────────────────────────────────────────────
# Signing key for the platform-admin session JWT. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Must be at least 32 bytes of entropy; the app refuses to start otherwise.
#
# Use a DIFFERENT value from the SEO admin's. Both apps sign with HS256 and both
# read `seo_admins`, so a shared secret would make the two sessions forgeable
# across apps — the audience claim is the only thing separating them, and a
# shared key means anyone who can mint one can mint the other.
ADMIN_JWT_SECRET="generate-me"

# ── Cross-app links ─────────────────────────────────────────────────────────
# Origin of the consumer app. Used to link out to a public shop profile from a
# claim or a dispute. Never fetched, only linked.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
