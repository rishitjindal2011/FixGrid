# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"

# Server-only. NEVER prefix with NEXT_PUBLIC_. Bypasses RLS — used solely by
# sitemap generation, the seeding script, and draft-mode page reads.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# ─── Site ────────────────────────────────────────────────────────────────────
# Canonical production origin. Used for canonical URLs, sitemap, robots, and
# JSON-LD. Must NOT be localhost in any deployed environment — `src/lib/site.ts`
# throws at build time if it is.
NEXT_PUBLIC_SITE_URL=https://www.vytron.me

# ─── Draft mode / preview ────────────────────────────────────────────────────
# Shared secret between the SEO admin dashboard and the main app. The admin
# links to /api/preview?secret=...&id=... to enable Next.js draft mode.
PREVIEW_SECRET=generate-with-openssl-rand-hex-32

# ─── SEO admin (App 2) ───────────────────────────────────────────────────────
# HS256 signing key for the local admin session JWT.
ADMIN_JWT_SECRET=generate-with-openssl-rand-hex-32

# ─── Email (Resend) ──────────────────────────────────────────────────────────
# Transactional email for bookings, reminders, and status updates.
# Create an API key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Verified sender in Resend. Format: "Display Name <email@yourdomain.com>"
RESEND_FROM_EMAIL="FixGrid <bookings@vytron.me>"

# Optional reply-to address shown to recipients.
RESEND_REPLY_TO_EMAIL=support@vytron.me

# Secret for the reminder cron route: GET /api/cron/reminders?secret=...
# Generate with: openssl rand -hex 32
CRON_SECRET=generate-with-openssl-rand-hex-32
